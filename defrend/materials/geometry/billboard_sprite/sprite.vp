#version 420 core

in vec4 position;
in vec2 texcoord0;
in vec3 normal;

uniform sprite_vp {
	mat4 mtx_proj;
	mat4 mtx_normal;
	mat4 mtx_view;
};

out vec3 var_frag_pos;
out vec3 var_normal;
out vec2 var_texcoord0;

void main() {
    vec4 p = mtx_view * position;
    var_frag_pos = p.xyz;
	var_normal = normalize(-var_frag_pos);
    var_texcoord0 = texcoord0;
    gl_Position = mtx_proj * p;
}
